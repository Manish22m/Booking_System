
server:
  port: PORT_NO

spring:
  application:
    name: SYSTEM_NAME

  datasource:
    url: JDBC_URL
    driver-class-name: org.h2.Driver
    username: USERNAME
    password: PASSWORD

  h2:
    console:
      enabled: true
      path: /h2-console

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        format_sql: true

jwt:
  secret: SECRET_KEY
  expiration-ms: EXP_TIME
